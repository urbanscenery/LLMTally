{
  "name": "llmtally",
  "version": "0.1.0",
  "description": "Per-prompt usage ledger and quota monitor for local AI coding agents (Claude Code, Codex CLI, OpenCode). Requires the Bun runtime.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llmtally/llmtally.git"
  },
  "homepage": "https://github.com/llmtally/llmtally",
  "keywords": [
    "llm",
    "usage",
    "ledger",
    "token",
    "cost",
    "claude-code",
    "codex",
    "opencode",
    "tui",
    "menubar"
  ],
  "bin": {
    "llmtally": "bin/llmtally.cjs"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "verify:compile": "bun scripts/verify-opentui-compile.ts",
    "install:local": "bun scripts/install-local.ts"
  },
  "files": [
    "bin",
    "packages",
    "tsconfig.json"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@opentui/core": "0.5.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
