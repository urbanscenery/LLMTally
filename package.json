{
  "name": "llmtally",
  "version": "0.1.0",
  "description": "Per-prompt usage ledger and quota monitor for local AI coding agents (Claude Code, Codex CLI, OpenCode, Cline, Antigravity, Grok Build, Cursor CLI). Requires the Bun runtime.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/llmtally/llmtally.git"
  },
  "homepage": "https://github.com/llmtally/llmtally",
  "keywords": [
    "llm",
    "usage",
    "ledger",
    "token",
    "cost",
    "claude-code",
    "codex",
    "opencode",
    "grok",
    "cursor",
    "tui",
    "menubar"
  ],
  "bin": {
    "llmtally": "bin/llmtally.cjs"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "coverage": "bun test --coverage",
    "build:keychain-helper": "bun scripts/build-keychain-helper.ts",
    "verify:keychain-helper": "bun scripts/build-keychain-helper.ts --check",
    "verify:compile": "bun scripts/verify-opentui-compile.ts",
    "verify:pack": "bun scripts/verify-pack-install.ts",
    "install:local": "bun scripts/install-local.ts",
    "install:app": "sh packages/app/scripts/install.sh",
    "prepack": "bun run verify:keychain-helper"
  },
  "files": [
    "bin",
    "packages",
    "packages/core/native/bin/darwin-universal/llmtally-keychain",
    "tsconfig.json"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@opentui/core": "0.5.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
